{
  "name": "pi-herdr-orchestration",
  "version": "0.1.1",
  "description": "Adapt skill-owned coding workflows to fresh, observable Herdr Core subagents",
  "type": "module",
  "license": "MIT",
  "author": "Oliver Ainger",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brutaldeluxe82/pi-herdr-orchestration.git"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "herdr",
    "orchestration",
    "subagents"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "extensions/",
    "herdr/",
    "prompts/",
    "skills/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node --check extensions/index.js && node --check extensions/template-sync.mjs && npm test"
  },
  "pi": {
    "extensions": ["./extensions/index.js"],
    "skills": ["./skills"],
    "prompts": ["./prompts/*.md"],
    "changelogPath": "./CHANGELOG.md"
  }
}
